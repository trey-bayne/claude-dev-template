        </mxCell>
        <mxCell id="n53" value="&lt;b&gt;.claude/settings.local.json&lt;/b&gt;&lt;div style=&quot;font-size:9px;color:#555555;margin-top:1px&quot;&gt;Claude Code writes this itself for local permission choices&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=10;verticalAlign=middle;fontSize=11;fillColor=#FFFFFF;strokeColor=#B85450;dashed=1;dashPattern=1 2;" vertex="1" parent="1">
