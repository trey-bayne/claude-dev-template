        </mxCell>
        <mxCell id="n54" value="&lt;b&gt;docker-compose.yml&lt;/b&gt;&lt;div style=&quot;font-size:9px;color:#555555;margin-top:1px&quot;&gt;NOT generated by the bootstrap — Phase 1 builds it&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=10;verticalAlign=middle;fontSize=11;fillColor=#FFFFFF;strokeColor=#B85450;dashed=1;dashPattern=1 2;" vertex="1" parent="1">
          <mxGeometry x="730" y="834" width="320" height="32" as="geometry" />
        </mxCell>
        <mxCell id="n55" value="&lt;b&gt;source directories&lt;/b&gt;&lt;div style=&quot;font-size:9px;color:#555555;margin-top:1px&quot;&gt;services/ src/ app/ — whatever the phases build&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=10;verticalAlign=middle;fontSize=11;fillColor=#FFFFFF;strokeColor=#B85450;dashed=1;dashPattern=1 2;" vertex="1" parent="1">
          <mxGeometry x="58" y="880" width="320" height="32" as="geometry" />
        </mxCell>
        <mxCell id="n56" value="&lt;b&gt;scripts/&lt;/b&gt;&lt;div style=&quot;font-size:9px;color:#555555;margin-top:1px&quot;&gt;Rebuild and deploy helpers the promotion commands call&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=10;verticalAlign=middle;fontSize=11;fillColor=#FFFFFF;strokeColor=#B85450;dashed=1;dashPattern=1 2;" vertex="1" parent="1">
          <mxGeometry x="394" y="880" width="320" height="32" as="geometry" />
        </mxCell>
        <mxCell id="n57" value="&lt;b&gt;config/ , logs/&lt;/b&gt;&lt;div style=&quot;font-size:9px;color:#555555;margin-top:1px&quot;&gt;Runtime state produced by the stack, usually gitignored&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=10;verticalAlign=middle;fontSize=11;fillColor=#FFFFFF;strokeColor=#B85450;dashed=1;dashPattern=1 2;" vertex="1" parent="1">
          <mxGeometry x="730" y="880" width="320" height="32" as="geometry" />
        </mxCell>
        <mxCell id="n58" value="Worth knowing: eight commands assume a Docker Compose stack (/status, /phase-complete, /phase-review, /phase-test, /codebase-review, /prj-manage, /phase-release, /phase-rollback) but the bootstrap never writes a compose file. Phase 1 has to, or those commands have nothing to talk to." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=9;fontColor=#B85450;fontStyle=0" vertex="1" parent="1">
          <mxGeometry x="58" y="930" width="990" height="40" as="geometry" />
        </mxCell>
        <mxCell id="n59" value="&lt;b&gt;Context tiers — the reason for the split&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fontStyle=1;fillColor=#FAFAFA;strokeColor=#9E9E9E;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="1006" width="1020" height="108" as="geometry" />
        </mxCell>
        <mxCell id="n60" value="&lt;b&gt;Tier 0&lt;/b&gt;&lt;div style=&quot;font-size:9px;color:#555555;margin-top:1px&quot;&gt;session-start.sh — fires before anything else&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=10;verticalAlign=middle;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="58" y="1040" width="320" height="32" as="geometry" />
        </mxCell>
        <mxCell id="n61" value="&lt;b&gt;Tier 1&lt;/b&gt;&lt;div style=&quot;font-size:9px;color:#555555;margin-top:1px&quot;&gt;CLAUDE.md, TASKS.md — every session, always&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=10;verticalAlign=middle;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1">
          <mxGeometry x="394" y="1040" width="320" height="32" as="geometry" />
        </mxCell>
        <mxCell id="n62" value="&lt;b&gt;Tier 2&lt;/b&gt;&lt;div style=&quot;font-size:9px;color:#555555;margin-top:1px&quot;&gt;docs/* — pulled only when relevant&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=10;verticalAlign=middle;fontSize=11;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1">
          <mxGeometry x="730" y="1040" width="320" height="32" as="geometry" />
        </mxCell>
        <mxCell id="n63" value="&lt;b&gt;Tier 3&lt;/b&gt;&lt;div style=&quot;font-size:9px;color:#555555;margin-top:1px&quot;&gt;PROJECT_BRIEF.md — rarely&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=10;verticalAlign=middle;fontSize=11;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1">
          <mxGeometry x="58" y="1080" width="320" height="32" as="geometry" />
        </mxCell>
        <mxCell id="n64" value="&lt;b&gt;Config&lt;/b&gt;&lt;div style=&quot;font-size:9px;color:#555555;margin-top:1px&quot;&gt;settings.json, PERMISSIONS.md, .env.example&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=10;verticalAlign=middle;fontSize=11;fillColor=#F5F5F5;strokeColor=#9E9E9E;" vertex="1" parent="1">
          <mxGeometry x="394" y="1080" width="320" height="32" as="geometry" />
        </mxCell>
        <mxCell id="n65" value="Every line in a Tier 1 file is loaded at the start of every session, so phase detail, env var tables and architecture diagrams belong in docs/ instead. That is the whole point of the structure: keep the always-loaded context small and relevant." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontColor=#555555;fontStyle=0" vertex="1" parent="1">
          <mxGeometry x="40" y="1124" width="1020" height="30" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
