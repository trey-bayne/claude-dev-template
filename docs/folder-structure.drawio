          <mxGeometry x="776" y="636" width="272" height="32" as="geometry" />
        </mxCell>
        <mxCell id="n50" value="Dashed = installed only when the project uses the two-branch promotion workflow. A single-branch project omits these four." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=9;fontColor=#666666;fontStyle=0" vertex="1" parent="1">
          <mxGeometry x="492" y="668" width="540" height="26" as="geometry" />
        </mxCell>
        <mxCell id="n51" value="&lt;b&gt;Everything above is all the bootstrap creates. These appear later — do not expect them in a freshly bootstrapped project:&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fontStyle=1;fillColor=#FAFAFA;strokeColor=#9E9E9E;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="786" width="1020" height="196" as="geometry" />
        </mxCell>
        <mxCell id="n52" value="&lt;b&gt;.env&lt;/b&gt;&lt;div style=&quot;font-size:9px;color:#555555;margin-top:1px&quot;&gt;You create it from .env.example. Never committed&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=10;verticalAlign=middle;fontSize=11;fillColor=#FFFFFF;strokeColor=#B85450;dashed=1;dashPattern=1 2;" vertex="1" parent="1">
