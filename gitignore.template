# This file ships as `.gitignore` at the root of a bootstrapped project.
# It is named gitignore.template here so it does not apply to the template repo itself.
#
# CLAUDE.md and TASKS.md are deliberately NOT ignored. The whole phase workflow depends
# on them being tracked and committed: /phase-complete commits and pushes TASKS.md,
# /phase-test commits it after advancing `## Resume Here`, and /phase-auto treats each
# committed TASKS.md as its crash-safety boundary. Ignoring them silently breaks all of
# that and leaves a cloned project with no context files at all.

# Secrets — real values never get committed
.env
.env.local
.env.*.local
# ...but the key list always does
!.env.example

# Bootstrap and conversion scratch (temporary copies of this template)
.template/
.claude_dev_template/

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo

# Build artifacts
dist/
build/
__pycache__/
*.pyc
*.pyo
node_modules/

# Logs
*.log
logs/
